<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="facebook.api.generator" type="Facebook.Api.Generator.Configuration.FacebookApiGeneratorSection, Facebook.Api.Generator" />
  </configSections>

  <facebook.api.generator>
    <methodPages>
      <add method="Dashboard.AddNews" />
      <add method="Dashboard.ClearNews" />
      <add method="Dashboard.GetNews" />

      <add method="Dashboard.AddGlobalNews" />
      <add method="Dashboard.ClearGlobalNews" />
      <add method="Dashboard.GetGlobalNews" />
      
      <add method="Dashboard.MultiAddNews" />
      <add method="Dashboard.MultiClearNews" />
      <add method="Dashboard.MultiGetNews" />
      
      <add method="Dashboard.GetActivity" />
      <add method="Dashboard.PublishActivity" />
      <add method="Dashboard.RemoveActivity" />
      
      <add method="Dashboard.DecrementCount" />
      <add method="Dashboard.GetCount" />
      <add method="Dashboard.IncrementCount" />
      <add method="Dashboard.SetCount" />

      <add method="Dashboard.MultiDecrementCount" />
      <add method="Dashboard.MultiGetCount" />
      <add method="Dashboard.MultiIncrementCount" />
      <add method="Dashboard.MultiSetCount" />
    </methodPages>
    <excludedMethods>
      <add method="Admin.GetDailyMetrics" />      
      <add method="Auth.GetSession" />
      <add method="Batch.Run" />
      <add method="Fbml.UploadNativeStrings" />
      <add method="Fql.Query" />
      <add method="Fql.Multiquery" />
      <add method="Feed.DeactivateTemplateBundleByID" />
      <add method="Feed.GetRegisteredTemplateBundleByID" />
      <add method="Feed.GetRegisteredTemplateBundles" />
      <add method="Feed.RegisterTemplateBundle" />
      <add method="Feed.PublishActionOfUser" />
      <add method="Feed.PublishStoryToUser" />
      <add method="Feed.PublishTemplatizedAction" />
      <add method="Feed.PublishUserAction" />
      <add method="Marketplace.CreateListing" />
      <add method="Marketplace.GetCategories" />
      <add method="Marketplace.GetListings" />
      <add method="Marketplace.GetSubCategories" />
      <add method="Marketplace.RemoveListing" />
      <add method="Marketplace.Search" />
      <add method="Notifications.Send" />
      <add method="Notifications.SendEmail" />      
      <add method="Profile.GetFBML" />
      <add method="Profile.GetInfo" />
      <add method="Profile.GetInfoOptions" />
      <add method="Profile.SetFBML" />
      <add method="Profile.SetInfo" />
      <add method="Profile.SetInfoOptions" />
      <add method="Users.GetInfo" />
      <add method="Users.GetStandardInfo" />
      <add method="Users.IsAppUser" />
      <add method="Video.Upload" />
    </excludedMethods>
    <explicitMethodDefinitions>
      <add method="Application.GetPublicInfo">
        <overloads>
          <add nameSuffix="ByAppId" params="application_id" />
          <add nameSuffix="ByApiKey" params="application_api_key" />
          <add nameSuffix="ByCanvasName" params="application_canvas_name" />
        </overloads>
      </add>
      <add method="Comments.Add">
        <overloads>
          <add params="xid,text" />
          <add params="xid,text,title,url" />
          <add params="xid,text,title,url,publish_to_stream" />
          <add params="xid,text,uid" />
          <add params="xid,text,uid,title,url" />
          <add params="xid,text,uid,title,url,publish_to_stream" />
        </overloads>
      </add>
      <add method="Events.Get">
        <!-- Note: Other overloads using start and end times have been manually entered to take the start or end time as a DateTime,
        rather than an integer as the API specifies. -->
        <overloads>
          <add params="uid" />
          <add params="uid,rsvp_status" />

          <add params="uid,eids" />
          <add params="uid,eids,rsvp_status" />

          <add params="eids" />
          <add params="eids,rsvp_status" />
        </overloads>
      </add>
      <add method="Friends.Get">
        <overloads>
          <add />
          <add params="uid" />
          <add nameSuffix="List" params="flid" />
        </overloads>
      </add>
      <add method="Links.Post">
        <overloads>
          <add params="uid,url,comment" />
          <add params="uid,url,comment,image" />
        </overloads>
      </add>
      <add method="Message.GetThreadsInFolder">
        <overloads>
          <add params="folder_id" />
          <add params="folder_id,limit" />
          <add params="folder_id,limit,offset" />
          <add nameSuffix="ByUid" params="uid,folder_id" />
          <add nameSuffix="ByUid" params="uid,folder_id,limit" />
          <add nameSuffix="ByUid" params="uid,folder_id,limit,offset" />
        </overloads>
      </add>
      <add method="Pages.IsFan">
        <overloads>
          <add params="page_id" />
          <add params="uid,page_id" />
        </overloads>
      </add>
      <add method="Photos.CreateAlbum">
        <overloads>
          <add params="name" />
          <add params="name,description" />
          <add params="name,description,location" />
          <add params="name,description,location,visible" />
          <add applicationType="Website" params="uid,name" />
          <add applicationType="Website" params="uid,name,description" />
          <add applicationType="Website" params="uid,name,description,location" />
          <add applicationType="Website" params="uid,name,description,location,visible" />
        </overloads>
      </add>
      <add method="Stream.Get">
        <overloads>
          <add params="limit" />
        </overloads>
      </add>
      <add method="Stream.Publish">
        <overloads>
          <add params="message" />
        </overloads>
      </add>
      <add method="Stream.Remove">
        <overloads>
          <add params="post_id" />
        </overloads>
      </add>
      <add method="Stream.RemoveLike">
        <overloads>
          <add params="post_id" />
        </overloads>
      </add>
      <add method="Stream.RemoveComment">
        <overloads>
          <add params="comment_id" />
        </overloads>
      </add>
      <add method="Stream.AddComment">
        <overloads>
          <add params="comment,post_id" />
        </overloads>
      </add>
      <add method="Stream.AddLike">
        <overloads>
          <add params="post_id" />
        </overloads>
      </add>
      <add method="Status.Get">
        <overloads>
          <add />
          <add params="limit" />
          <add nameSuffix="ByUid" params="uid" />
          <add nameSuffix="ByUid" params="uid,limit" />
        </overloads>
      </add>
      <add method="Status.Set">
        <overloads>
          <add params="status" />
          <add applicationType="Website" params="uid,status" />
        </overloads>
      </add>
      <add method="Users.SetStatus">
        <overloads>
          <add params="clear" />
          <!-- These overloads are allowed for both types of contexts (the default applicationType value is Web|Desktop), so they should go in FacebookContextBase.  -->
          <add params="status" />
          <add params="status,status_includes_verb" />
          <add applicationType="Website" params="uid,clear" />
          <!-- These overloads are only allowed in web applications, so they should only go in FacebookWebContext. -->
          <add applicationType="Website" params="uid,status" />
          <add applicationType="Website" params="uid,status,status_includes_verb" />
        </overloads>
        <attributes>
          <!-- any attributes should be added to the method -->
          <add typeName="System.ObsoleteAttribute">
            <params>
              <add param="Message" value="Use Status.Set() instead." />
            </params>
          </add>
        </attributes>
      </add>

    </explicitMethodDefinitions>

  </facebook.api.generator>
</configuration>