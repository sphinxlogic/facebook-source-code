<%@ Master Language="C#" Inherits="Facebook.Web.Mvc.FacebookViewMasterPage" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" xmlns:fb="http://www.facebook.com/2008/fbml">
<head runat="server">
    <title><asp:ContentPlaceHolder ID="title" runat="server" /></title>
    <link href="/Content/site.css" type="text/css" rel="Stylesheet" />
    <link href="/Content/facebook.css" type="text/css" rel="Stylesheet" />
    <script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.3.2/jquery.min.js"></script>
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
    <script src="http://static.ak.facebook.com/js/api_lib/v0.4/FeatureLoader.js.php" type="text/javascript"></script>

    <div class="dashboard_header">
        <div class="dh_links clearfix">
            <div class="dh_actions">
                <a href="/invite">Invite Friends</a>
                <fb:IfIsAppUser ID="IfIsAppUser1" runat="server">  
                    <span class="pipe">|</span>                           
                    <a href="/auth/revoke">Deauthorize</a>   
                </fb:IfIsAppUser>
            </div>
            <div class="dh_help">
                <a href="http://bit.ly/dotnetfbapi" target="_blank">CodePlex Project</a>
                <span class="pipe">|</span>
                <a href="http://bit.ly/fbapidoc" target="_blank">Documentation</a>
            </div>
        </div>
        <div class="dh_titlebar clearfix">
            <h2 style="background-image: url(http://photos-a.ak.fbcdn.net/photos-ak-sf2p/v43/112/68328539608/app_2_68328539608_8737.gif);">.NET API Client</h2>
        </div>
    </div>
    
    <div id="page">
        
        <div class="section" id="nav" style="float: left;background-color: #e0e5ee;padding:10px;margin-right:10px;">
            <h2>Navigation</h2>
            <div class="content">
                <ul style="list-style-type: none;padding:0;">
                    <li style="margin-bottom: 5px;"><a href="/">Home</a></li>
                    <li><b>Demos</b></li>
                    <li><%= FbIFrame.ActionLink("Admin", "/demo/admin", true)%></li>
                    <li><%= FbIFrame.ActionLink("Application", "/demo/application", true)%></li>
                    <li><%--<a href="/dotnetapi/demo/comments" requirelogin=1>--%>Comments<%--</a>--%></li>
                    <li><%--<a href="/dotnetapi/demo/data" requirelogin=1>--%>Data<%--</a>--%></li>
                    <li><%--<a href="/dotnetapi/demo/events" requirelogin=1>--%>Events<%--</a>--%></li>
                    <li><%--<a href="/dotnetapi/demo/fbml" requirelogin=1>--%>FBML<%--</a>--%></li>
                    <li><%= FbIFrame.ActionLink("Feed", "/demo/feed", true)%></li>
                    <li><%= FbIFrame.ActionLink("FQL", "/demo/fql", true)%></li>  
                    <li><%--<a href="/dotnetapi/demo/friends" requirelogin=1>--%>Friends<%--</a>--%></li>
                    <li><%--<a href="/dotnetapi/demo/groups" requirelogin=1>--%>Groups<%--</a>--%></li>
                    <li><%= FbIFrame.ActionLink("SC Headliners", "/demo/headliners", true)%></li>
                    <li><%= FbIFrame.ActionLink("Links", "/demo/links", "share_item")%></li>
                    <li><%= FbIFrame.ActionLink("Live Message", "/demo/livemessage", true)%></li>
                    <li><%--<a href="/dotnetapi/demo/marketplace" requirelogin=1>--%>Marketplace<%--</a>--%></li>
                    <li><%= FbIFrame.ActionLink("Notes", "/demo/notes", "create_note")%></li>
                    <li><%= FbIFrame.ActionLink("Notifications", "/demo/notifications", true)%></li>
                    <li><%--<a href="/dotnetapi/demo/pages" requirelogin=1>--%>Pages<%--</a>--%></li>
                    <li><%--<a href="/dotnetapi/demo/photos" requirelogin=1>--%>Photos<%--</a>--%></li>
                    <li><%--<a href="/dotnetapi/demo/profile" requirelogin=1>--%>Profile<%--</a>--%></li>
                    <li><%= FbIFrame.ActionLink("Status", "/demo/status", "status_update")%></li>
                    <li><%= FbIFrame.ActionLink("Stream", "/demo/stream", "read_stream")%></li>
                    <li><%= FbIFrame.ActionLink("Users", "/demo/users", true)%></li>
                    <li><%--<a href="/dotnetapi/demo/video" requirelogin=1>--%>Video<%--</a>--%></li>                  
                </ul>
            </div>
        </div>
    
        <div id="main" style="padding:10px;float:left">
            <asp:ContentPlaceHolder ID="content" runat="server" />
        </div>
        <br class="clear" />
    </div>
    <br class="clear" />
    
    <script type="text/javascript">
        FB_RequireFeatures(["XFBML", "CanvasUtil", "Api"], function() {
            FB.Facebook.init("<%= this.FbContext.ApiKey %>", "/xd_receiver.htm");
            FB.XdComm.Server.init("/xd_receiver.htm");
            FB.CanvasClient.startTimerToSizeToContent();
        });
    </script>
    
    <script type="text/javascript">
        var gaJsHost = (("https:" == document.location.protocol) ? "https://ssl." : "http://www.");
        document.write(unescape("%3Cscript src='" + gaJsHost + "google-analytics.com/ga.js' type='text/javascript'%3E%3C/script%3E"));
    </script>
    <script type="text/javascript">
        try {
            var pageTracker = _gat._getTracker("UA-174697-16");
            pageTracker._trackPageview();
        } catch (err) { }
    </script>
    
</body>
</html>